{
  "version": "1.0",
  "enforce_strict_isolation": true,
  "blocked_categories": [
    "executable_code",
    "system_credentials",
    "self_modification_instruction"
  ],
  "forbidden_patterns": [
    "(?i)import\\s+(os|sys|subprocess|shutil)",
    "(?i)eval\\(.*?\\)",
    "(?i)exec\\(.*?\\)",
    "sk-[a-zA-Z0-9]{20,}",
    "AIZA[0-9A-Za-z-_]{35}",
    "(?i)(password|secret|api_key)\\s*=\\s*['\\\"][^'\\\"]+['\\\"]"
  ],
  "blocked_keywords": [
    "ignore previous instructions",
    "bypass guardrails",
    "override system prompt",
    "sudo rm -rf",
    "chmod +x"
  ]
}